{
  "ConnectionStrings": {
    "DefaultConnection": "Host=staging-db-host;Database=gameserverhosting_staging;Username=staging_user;Password=REPLACE_WITH_STAGING_PASSWORD"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging.gameserverhosting.com",
      "https://staging-admin.gameserverhosting.com"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "EmailSettings": {
    "Provider": "SendGrid",
    "FromEmail": "noreply@staging.gameserverhosting.com",
    "FromName": "Game Server Hosting (Staging)",
    "SendGrid": {
      "ApiKey": "REPLACE_WITH_STAGING_SENDGRID_API_KEY"
    },
    "VerificationTokenExpirationHours": 24,
    "BaseUrl": "https://staging.gameserverhosting.com"
  },
  "Stripe": {
    "SecretKey": "REPLACE_WITH_STRIPE_TEST_SECRET_KEY",
    "PublishableKey": "REPLACE_WITH_STRIPE_TEST_PUBLISHABLE_KEY",
    "WebhookSecret": "REPLACE_WITH_STRIPE_TEST_WEBHOOK_SECRET",
    "Currency": "usd",
    "SuccessUrl": "https://staging.gameserverhosting.com/checkout/success",
    "CancelUrl": "https://staging.gameserverhosting.com/checkout/cancel"
  },
  "AllowedHosts": "*.gameserverhosting.com"
}
