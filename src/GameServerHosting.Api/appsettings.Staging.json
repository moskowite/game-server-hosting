{
  "ConnectionStrings": {
    "DefaultConnection": "Host=staging-db-host;Database=gameserverhosting_staging;Username=staging_user;Password=REPLACE_WITH_STAGING_PASSWORD"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging.gameserverhosting.com",
      "https://staging-admin.gameserverhosting.com"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*.gameserverhosting.com"
}
