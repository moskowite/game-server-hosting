{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=gameserverhosting_dev;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Quartz": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev/gameserver-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Cors": {
    "PolicyName": "GameServerHostingPolicy",
    "AllowAnyLocalhostOrigin": true,
    "AllowedOrigins": [],
    "AllowCredentials": true,
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH" ],
    "AllowedHeaders": [ "*" ]
  },
  "Swagger": {
    "Enabled": true
  },
  "JwtSettings": {
    "SecretKey": "DevSecretKey_ThisIsOnlyForDevelopment_MustBeAtLeast32Characters!",
    "ExpirationInMinutes": 120
  },
  "EmailSettings": {
    "Provider": "SMTP",
    "FromEmail": "dev@gameserverhosting.local",
    "FromName": "Game Server Hosting (Dev)",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Username": "",
      "Password": "",
      "EnableSsl": false
    },
    "BaseUrl": "http://localhost:5000"
  },
  "Stripe": {
    "SecretKey": "REPLACE_WITH_STRIPE_TEST_SECRET_KEY",
    "PublishableKey": "REPLACE_WITH_STRIPE_TEST_PUBLISHABLE_KEY",
    "WebhookSecret": "REPLACE_WITH_STRIPE_TEST_WEBHOOK_SECRET",
    "Currency": "usd",
    "SuccessUrl": "http://localhost:5000/checkout/success",
    "CancelUrl": "http://localhost:5000/checkout/cancel"
  },
  "Jobs": {
    "HealthCheck": {
      "Enabled": true,
      "CronSchedule": "0 0/2 * * * ?",
      "Description": "Runs every 2 minutes in development"
    }
  }
}
