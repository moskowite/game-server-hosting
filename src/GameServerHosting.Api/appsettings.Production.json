{
  "ConnectionStrings": {
    "DefaultConnection": "Host=prod-db-host;Database=gameserverhosting;Username=prod_user;Password=REPLACE_WITH_PRODUCTION_PASSWORD"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://gameserverhosting.com",
      "https://www.gameserverhosting.com",
      "https://admin.gameserverhosting.com"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_PRODUCTION_SECRET_KEY_FROM_ENVIRONMENT_VARIABLES",
    "ExpirationInMinutes": 30,
    "RefreshTokenExpirationInDays": 30
  },
  "AllowedHosts": "*.gameserverhosting.com"
}
