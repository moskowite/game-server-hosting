{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=gameserverhosting;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gameserver-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [{ThreadId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ],
    "Properties": {
      "Application": "GameServerHosting.Api"
    }
  },
  "Cors": {
    "PolicyName": "GameServerHostingPolicy",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5000",
      "https://localhost:5001"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true,
    "MaxAge": 3600
  },
  "Swagger": {
    "Enabled": true,
    "Title": "Game Server Hosting API",
    "Version": "v1",
    "Description": "API for managing game server hosting services",
    "Contact": {
      "Name": "Game Server Hosting Team",
      "Email": "support@gameserverhosting.com",
      "Url": "https://gameserverhosting.com"
    }
  },
  "AllowedHosts": "*"
}
