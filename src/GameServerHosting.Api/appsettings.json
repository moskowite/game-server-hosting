{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=gameserverhosting;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gameserver-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [{ThreadId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ],
    "Properties": {
      "Application": "GameServerHosting.Api"
    }
  },
  "Cors": {
    "PolicyName": "GameServerHostingPolicy",
    "AllowAnyLocalhostOrigin": false,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5000",
      "https://localhost:5001"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true,
    "MaxAge": 3600
  },
  "Swagger": {
    "Enabled": true,
    "Title": "Game Server Hosting API",
    "Version": "v1",
    "Description": "API for managing game server hosting services",
    "Contact": {
      "Name": "Game Server Hosting Team",
      "Email": "support@gameserverhosting.com",
      "Url": "https://gameserverhosting.com"
    }
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_PRODUCTION",
    "Issuer": "GameServerHosting.Api",
    "Audience": "GameServerHosting.Client",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "EmailSettings": {
    "Provider": "SMTP",
    "FromEmail": "noreply@gameserverhosting.com",
    "FromName": "Game Server Hosting",
    "SendGrid": {
      "ApiKey": ""
    },
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Username": "",
      "Password": "",
      "EnableSsl": false
    },
    "Templates": {
      "EmailVerificationSubject": "Verify Your Email - Game Server Hosting",
      "PasswordResetSubject": "Reset Your Password - Game Server Hosting"
    },
    "VerificationTokenExpirationHours": 24,
    "BaseUrl": "http://localhost:5000"
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "Currency": "usd",
    "SuccessUrl": "http://localhost:5000/checkout/success",
    "CancelUrl": "http://localhost:5000/checkout/cancel"
  },
  "CloudProviders": {
    "Default": "DigitalOcean",
    "DigitalOcean": {
      "ApiToken": "",
      "ApiBaseUrl": "https://api.digitalocean.com/v2",
      "DefaultRegion": "nyc3",
      "SshKeyId": "",
      "ProvisioningTimeoutSeconds": 300,
      "EnableMonitoring": true,
      "EnableBackups": false,
      "DefaultTags": [ "game-server", "production" ]
    }
  },
  "Provisioning": {
    "MaxConcurrentProvisions": 10,
    "RetryAttempts": 3,
    "RetryDelaySeconds": [ 60, 300, 900 ],
    "HealthCheckIntervalMinutes": 5,
    "AutoRollbackOnFailure": true,
    "SendNotifications": true,
    "DefaultProvider": "DigitalOcean"
  },
  "Quartz": {
    "quartz.scheduler.instanceName": "GameServerHostingScheduler",
    "quartz.scheduler.instanceId": "AUTO",
    "quartz.threadPool.type": "Quartz.Simpl.DefaultThreadPool, Quartz",
    "quartz.threadPool.threadCount": 10,
    "quartz.threadPool.threadPriority": "Normal",
    "quartz.jobStore.type": "Quartz.Simpl.RAMJobStore, Quartz",
    "quartz.serializer.type": "json",
    "quartz.plugin.jobHistory.type": "Quartz.Plugin.History.LoggingJobHistoryPlugin, Quartz.Plugins",
    "quartz.plugin.jobHistory.jobToBeFiredMessage": "Job {1}.{0} is about to execute",
    "quartz.plugin.jobHistory.jobSuccessMessage": "Job {1}.{0} executed successfully",
    "quartz.plugin.jobHistory.jobFailedMessage": "Job {1}.{0} failed with exception: {8}"
  },
  "Jobs": {
    "HealthCheck": {
      "Enabled": true,
      "CronSchedule": "0 0/5 * * * ?",
      "Description": "Runs every 5 minutes to check server health"
    },
    "Provisioning": {
      "MaxRetries": 3,
      "RetryIntervalSeconds": [ 60, 300, 900 ],
      "Description": "Retries: immediate, 1 minute, 5 minutes, 15 minutes"
    }
  },
  "AllowedHosts": "*"
}
