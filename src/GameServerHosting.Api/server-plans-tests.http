}

### Create a new server plan - Annual (Admin only)
POST {{baseUrl}}/api/server-plans
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "serverTypeId": "{{serverTypeId}}",
  "name": "Annual Plan",
  "billingCycle": "Annual",
  "price": 150.00,
  "currency": "USD",
  "durationHours": 8760,
  "discountPercentage": 25,
  "isActive": true,
  "displayOrder": 4,
  "description": "Ultimate savings - save 25% compared to hourly rate. Best for production environments."
}

### Update a server plan (Admin only)
PUT {{baseUrl}}/api/server-plans/{{serverPlanId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Monthly Premium Plan",
  "billingCycle": "Monthly",
  "price": 20.00,
  "currency": "USD",
  "durationHours": 720,
  "discountPercentage": 15,
  "isActive": true,
  "displayOrder": 2,
  "description": "Premium monthly plan with enhanced support and 15% discount"
}

### Delete a server plan (Admin only)
DELETE {{baseUrl}}/api/server-plans/{{serverPlanId}}
Authorization: Bearer {{token}}
