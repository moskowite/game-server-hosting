@page "/forgot-password"
@using GameServerHosting.Client.Models.Auth
@using GameServerHosting.Client.Services
@inject AuthenticationService AuthService

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Forgot Password?</h1>
            <p>Enter your email and we'll send you a reset link</p>
        </div>

        @if (_emailSent)
        {
            <div class="alert alert-success">
                <span class="bi bi-check-circle-fill"></span>
                <div>
                    <strong>Check your email</strong>
                    <p>If an account exists with the email you provided, you will receive a password reset link shortly.</p>
                </div>
            </div>
            <div class="auth-footer">
                <a href="/login" class="link-primary">← Back to Login</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-error">
                    <span class="bi bi-exclamation-triangle-fill"></span>
                    @_errorMessage
                </div>
            }

            <EditForm Model="@_forgotPasswordModel" OnValidSubmit="HandleForgotPassword" class="auth-form">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <InputText id="email" @bind-Value="_forgotPasswordModel.Email" class="form-control" placeholder="you@example.com" />
                    <ValidationMessage For="@(() => _forgotPasswordModel.Email)" class="validation-message" />
                </div>

                <button type="submit" class="btn btn-primary btn-block" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </button>
            </EditForm>

            <div class="auth-footer">
                <a href="/login" class="link-primary">← Back to Login</a>
            </div>
        }
    </div>
</div>

@code {
    private ForgotPasswordRequest _forgotPasswordModel = new();
    private string? _errorMessage;
    private bool _isLoading = false;
    private bool _emailSent = false;

    private async Task HandleForgotPassword()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(_forgotPasswordModel.Email);

            if (result.Success)
            {
                _emailSent = true;
            }
            else
            {
                _errorMessage = result.Message ?? "An error occurred. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
