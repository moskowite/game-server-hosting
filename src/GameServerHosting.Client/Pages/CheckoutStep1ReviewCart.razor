@using GameServerHosting.Client.Models
@using GameServerHosting.Client.Services
@inject CheckoutService CheckoutService

<link href="Pages/CheckoutSteps.css" rel="stylesheet" />

<div class="checkout-step">
    <div class="step-header">
        <h2 class="step-title">
            <span class="bi bi-cart-check"></span>
            Review Your Order
        </h2>
        <p class="step-description">Review the items in your cart before proceeding</p>
    </div>

    <div class="cart-review">
        @foreach (var item in CheckoutService.State.CartItems)
        {
            <div class="review-item">
                <div class="item-icon">
                    <span class="bi @GetServerIcon(item.ServerPlan?.Name ?? "")"></span>
                </div>
                
                <div class="item-details">
                    <h4 class="item-name">@item.ServerPlan?.Name</h4>
                    <p class="item-description">@item.ServerPlan?.Description</p>
                    
                    <div class="item-specs">
                        <div class="spec-item">
                            <span class="bi bi-tag"></span>
                            <span>@item.ServerPlan?.Name</span>
                        </div>
                        <div class="spec-item">
                            <span class="bi bi-currency-dollar"></span>
                            <span>$@item.ServerPlan?.Price.ToString("F2")</span>
                        </div>
                        <div class="spec-item">
                            <span class="bi bi-clock"></span>
                            <span>@GetBillingCycleText(item.ServerPlan?.BillingCycle)</span>
                        </div>
                    </div>

                    @if (item.ServerPlan?.DiscountPercentage > 0)
                    {
                        <div class="discount-badge">
                            <span class="bi bi-tag-fill"></span>
                            @item.ServerPlan.DiscountPercentage% OFF
                        </div>
                    }
                </div>

                <div class="item-quantity">
                    <div class="qty-label">Quantity</div>
                    <div class="qty-value">@item.Quantity</div>
                </div>

                <div class="item-pricing">
                    <div class="price-label">Price</div>
                    <div class="price-value">$@item.Price.ToString("F2")</div>
                    @if (item.Quantity > 1)
                    {
                        <div class="price-each">$@item.Price.ToString("F2") each</div>
                    }
                </div>

                <div class="item-total">
                    <div class="total-label">Total</div>
                    <div class="total-value">$@((item.Price * item.Quantity).ToString("F2"))</div>
                </div>
            </div>
        }
    </div>

    <div class="review-summary">
        <div class="summary-box">
            <div class="summary-stat">
                <span class="bi bi-box-seam"></span>
                <div>
                    <div class="stat-value">@CheckoutService.State.CartItems.Count</div>
                    <div class="stat-label">Server Plan@(CheckoutService.State.CartItems.Count != 1 ? "s" : "")</div>
                </div>
            </div>
            <div class="summary-stat">
                <span class="bi bi-collection"></span>
                <div>
                    <div class="stat-value">@CheckoutService.State.CartItems.Sum(i => i.Quantity)</div>
                    <div class="stat-label">Total Server@(CheckoutService.State.CartItems.Sum(i => i.Quantity) != 1 ? "s" : "")</div>
                </div>
            </div>
            <div class="summary-stat">
                <span class="bi bi-currency-dollar"></span>
                <div>
                    <div class="stat-value">$@CheckoutService.State.Subtotal.ToString("F2")</div>
                    <div class="stat-label">Subtotal</div>
                </div>
            </div>
        </div>
    </div>

    <div class="review-note">
        <span class="bi bi-info-circle"></span>
        <p>You'll configure each server in the next step before completing your purchase.</p>
    </div>
</div>

@code {
    private string GetServerIcon(string planName)
    {
        var lowerName = planName.ToLower();
        if (lowerName.Contains("minecraft")) return "bi-square-fill";
        if (lowerName.Contains("rust")) return "bi-hammer";
        if (lowerName.Contains("ark")) return "bi-egg";
        if (lowerName.Contains("valheim")) return "bi-shield-fill";
        if (lowerName.Contains("terraria")) return "bi-tree-fill";
        if (lowerName.Contains("counter") || lowerName.Contains("cs:go")) return "bi-crosshair";
        return "bi-server";
    }

    private string GetBillingCycleText(GameServerHosting.Shared.Enums.BillingCycle? billingCycle)
    {
        return billingCycle?.ToString() ?? "Monthly";
    }
}
