@page "/servers"
@using GameServerHosting.Client.Models
@using GameServerHosting.Client.Services
@inject ServerCatalogService ServerCatalogService

<PageTitle>Server Catalog</PageTitle>

<div class="catalog-container">
    <div class="catalog-header">
        <h1 class="catalog-title">Game Server Catalog</h1>
        <p class="catalog-subtitle">Choose the perfect server for your gaming needs</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="loading-text">Loading servers...</p>
        </div>
    }
    else if (serverTypes == null || !serverTypes.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <span class="bi bi-server"></span>
            </div>
            <h3>No Servers Available</h3>
            <p>Check back later for new server options.</p>
        </div>
    }
    else
    {
        <div class="filter-section">
            <!-- Search Bar -->
            <div class="search-bar">
                <span class="bi bi-search search-icon"></span>
                <input type="text" 
                       class="form-control search-input" 
                       placeholder="Search by server name or description..." 
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @oninput="OnSearchChanged" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="clear-search" @onclick="ClearSearch">
                        <span class="bi bi-x"></span>
                    </button>
                }
            </div>

            <!-- Filter and Sort Controls -->
            <div class="filter-controls">
                <div class="filter-row">
                    <!-- Game Filter -->
                    <div class="filter-item">
                        <label for="game-filter">Game:</label>
                        <select id="game-filter" class="form-select" @onchange="OnGameFilterChanged">
                            <option value="">All Games</option>
                            @foreach (var game in gameNames)
                            {
                                <option value="@game">@game</option>
                            }
                        </select>
                    </div>

                    <!-- Sort Options -->
                    <div class="filter-item">
                        <label for="sort-select">Sort By:</label>
                        <select id="sort-select" class="form-select" @onchange="OnSortChanged">
                            <option value="name">Name (A-Z)</option>
                            <option value="name-desc">Name (Z-A)</option>
                            <option value="game">Game Type</option>
                            <option value="price-asc">Price (Low to High)</option>
                            <option value="price-desc" selected>Price (High to Low)</option>
                            <option value="cpu-desc">CPU (High to Low)</option>
                            <option value="ram-desc">RAM (High to Low)</option>
                            <option value="players-desc">Max Players (High to Low)</option>
                        </select>
                    </div>

                    <!-- Toggle Advanced Filters -->
                    <div class="filter-item">
                        <button class="btn btn-outline-secondary toggle-filters" @onclick="ToggleAdvancedFilters">
                            <span class="bi @(showAdvancedFilters ? "bi-chevron-up" : "bi-chevron-down")"></span>
                            @(showAdvancedFilters ? "Hide" : "Show") Filters
                        </button>
                    </div>
                </div>

                <!-- Advanced Filters -->
                @if (showAdvancedFilters)
                {
                    <div class="advanced-filters">
                        <div class="filter-row">
                            <!-- Price Range -->
                            <div class="filter-item">
                                <label>Max Monthly Price:</label>
                                <div class="range-filter">
                                    <input type="range" 
                                           class="form-range" 
                                           min="0" 
                                           max="200" 
                                           step="10"
                                           @bind="maxPrice"
                                           @bind:event="oninput"
                                           @oninput="OnFilterChanged" />
                                    <span class="range-value">@(maxPrice == 200 ? "Any" : $"${maxPrice}")</span>
                                </div>
                            </div>

                            <!-- Min CPU -->
                            <div class="filter-item">
                                <label>Min CPU Cores:</label>
                                <div class="range-filter">
                                    <input type="range" 
                                           class="form-range" 
                                           min="0" 
                                           max="16" 
                                           step="1"
                                           @bind="minCpu"
                                           @bind:event="oninput"
                                           @oninput="OnFilterChanged" />
                                    <span class="range-value">@(minCpu == 0 ? "Any" : $"{minCpu}")</span>
                                </div>
                            </div>

                            <!-- Min RAM -->
                            <div class="filter-item">
                                <label>Min RAM (GB):</label>
                                <div class="range-filter">
                                    <input type="range" 
                                           class="form-range" 
                                           min="0" 
                                           max="32" 
                                           step="1"
                                           @bind="minRam"
                                           @bind:event="oninput"
                                           @oninput="OnFilterChanged" />
                                    <span class="range-value">@(minRam == 0 ? "Any" : $"{minRam} GB")</span>
                                </div>
                            </div>

                            <!-- Min Storage -->
                            <div class="filter-item">
                                <label>Min Storage (GB):</label>
                                <div class="range-filter">
                                    <input type="range" 
                                           class="form-range" 
                                           min="0" 
                                           max="500" 
                                           step="10"
                                           @bind="minStorage"
                                           @bind:event="oninput"
                                           @oninput="OnFilterChanged" />
                                    <span class="range-value">@(minStorage == 0 ? "Any" : $"{minStorage} GB")</span>
                                </div>
                            </div>

                            <!-- Min Players -->
                            <div class="filter-item">
                                <label>Min Players:</label>
                                <div class="range-filter">
                                    <input type="range" 
                                           class="form-range" 
                                           min="0" 
                                           max="200" 
                                           step="10"
                                           @bind="minPlayers"
                                           @bind:event="oninput"
                                           @oninput="OnFilterChanged" />
                                    <span class="range-value">@(minPlayers == 0 ? "Any" : $"{minPlayers}")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Clear Filters Button -->
                        <div class="filter-actions">
                            <button class="btn btn-sm btn-outline-danger" @onclick="ClearAllFilters">
                                <span class="bi bi-x-circle"></span> Clear All Filters
                            </button>
                            <span class="results-count">Showing @filteredServerTypes.Count of @serverTypes?.Count servers</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!filteredServerTypes.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <span class="bi bi-funnel"></span>
                </div>
                <h3>No Servers Match Your Filters</h3>
                <p>Try adjusting your search criteria or clear filters to see more options.</p>
                <button class="btn btn-primary" @onclick="ClearAllFilters">Clear Filters</button>
            </div>
        }
        else
        {
            <div class="server-grid">
            @foreach (var server in filteredServerTypes)
            {
                <div class="server-card" @onclick="() => SelectServer(server)">
                    <div class="card-header">
                        <div class="game-icon">
                            <span class="bi @GetGameIcon(server.GameName)"></span>
                        </div>
                        <div class="card-badge">
                            @server.GameName
                        </div>
                    </div>
                    
                    <div class="card-body">
                        <h3 class="server-name">@server.Name</h3>
                        <p class="server-description">@server.Description</p>
                        
                        <div class="server-specs">
                            <div class="spec-item">
                                <span class="bi bi-cpu"></span>
                                <span class="spec-label">CPU</span>
                                <span class="spec-value">@server.CpuCores Cores</span>
                            </div>
                            <div class="spec-item">
                                <span class="bi bi-memory"></span>
                                <span class="spec-label">RAM</span>
                                <span class="spec-value">@FormatMemory(server.RamMb)</span>
                            </div>
                            <div class="spec-item">
                                <span class="bi bi-hdd"></span>
                                <span class="spec-label">Storage</span>
                                <span class="spec-value">@server.DiskGb GB</span>
                            </div>
                            <div class="spec-item">
                                <span class="bi bi-people"></span>
                                <span class="spec-label">Players</span>
                                <span class="spec-value">Up to @server.MaxPlayers</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer">
                        <div class="pricing">
                            <div class="price-item">
                                <span class="price-label">Hourly</span>
                                <span class="price-value">$@server.HourlyPrice.ToString("F2")/hr</span>
                            </div>
                            <div class="price-item featured">
                                <span class="price-label">Monthly</span>
                                <span class="price-value">$@server.MonthlyPrice.ToString("F2")/mo</span>
                                <span class="savings">Save @CalculateSavings(server)%</span>
                            </div>
                        </div>
                        <button class="btn btn-primary select-btn">
                            Select Server
                            <span class="bi bi-arrow-right"></span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServerTypeDto>? serverTypes;
    private List<ServerTypeDto> filteredServerTypes = new();
    private List<string> gameNames = new();
    private bool isLoading = true;
    
    // Search and Filter State
    private string searchQuery = "";
    private string selectedGameFilter = "";
    private string sortBy = "price-desc";
    private bool showAdvancedFilters = false;
    
    // Advanced Filter State
    private int maxPrice = 200;
    private int minCpu = 0;
    private int minRam = 0;
    private int minStorage = 0;
    private int minPlayers = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadServerTypes();
    }

    private async Task LoadServerTypes()
    {
        isLoading = true;
        serverTypes = await ServerCatalogService.GetServerTypesAsync(isActive: true);
        
        if (serverTypes != null && serverTypes.Any())
        {
            gameNames = serverTypes
                .Select(s => s.GameName)
                .Distinct()
                .OrderBy(g => g)
                .ToList();
            
            ApplyFiltersAndSort();
        }
        
        isLoading = false;
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFiltersAndSort();
    }

    private void OnGameFilterChanged(ChangeEventArgs e)
    {
        selectedGameFilter = e.Value?.ToString() ?? "";
        ApplyFiltersAndSort();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "price-desc";
        ApplyFiltersAndSort();
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        ApplyFiltersAndSort();
    }

    private void ToggleAdvancedFilters()
    {
        showAdvancedFilters = !showAdvancedFilters;
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFiltersAndSort();
    }

    private void ClearAllFilters()
    {
        searchQuery = "";
        selectedGameFilter = "";
        maxPrice = 200;
        minCpu = 0;
        minRam = 0;
        minStorage = 0;
        minPlayers = 0;
        ApplyFiltersAndSort();
    }

    private void ApplyFiltersAndSort()
    {
        if (serverTypes == null) return;

        // Start with all servers
        var filtered = serverTypes.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            filtered = filtered.Where(s => 
                s.Name.ToLower().Contains(query) || 
                s.Description.ToLower().Contains(query) ||
                s.GameName.ToLower().Contains(query));
        }

        // Apply game filter
        if (!string.IsNullOrEmpty(selectedGameFilter))
        {
            filtered = filtered.Where(s => 
                s.GameName.Equals(selectedGameFilter, StringComparison.OrdinalIgnoreCase));
        }

        // Apply advanced filters
        if (maxPrice < 200)
        {
            filtered = filtered.Where(s => s.MonthlyPrice <= maxPrice);
        }

        if (minCpu > 0)
        {
            filtered = filtered.Where(s => s.CpuCores >= minCpu);
        }

        if (minRam > 0)
        {
            filtered = filtered.Where(s => s.RamMb >= minRam * 1024);
        }

        if (minStorage > 0)
        {
            filtered = filtered.Where(s => s.DiskGb >= minStorage);
        }

        if (minPlayers > 0)
        {
            filtered = filtered.Where(s => s.MaxPlayers >= minPlayers);
        }

        // Apply sorting
        filtered = sortBy switch
        {
            "name" => filtered.OrderBy(s => s.Name),
            "name-desc" => filtered.OrderByDescending(s => s.Name),
            "game" => filtered.OrderBy(s => s.GameName).ThenBy(s => s.Name),
            "price-asc" => filtered.OrderBy(s => s.MonthlyPrice).ThenBy(s => s.Name),
            "price-desc" => filtered.OrderByDescending(s => s.MonthlyPrice).ThenBy(s => s.Name),
            "cpu-desc" => filtered.OrderByDescending(s => s.CpuCores).ThenBy(s => s.Name),
            "ram-desc" => filtered.OrderByDescending(s => s.RamMb).ThenBy(s => s.Name),
            "players-desc" => filtered.OrderByDescending(s => s.MaxPlayers).ThenBy(s => s.Name),
            _ => filtered.OrderByDescending(s => s.MonthlyPrice).ThenBy(s => s.Name)
        };

        filteredServerTypes = filtered.ToList();
    }

    private void SelectServer(ServerTypeDto server)
    {
        // TODO: Navigate to server order page or show details
        Console.WriteLine($"Selected server: {server.Name}");
    }

    private string GetGameIcon(string gameName)
    {
        return gameName.ToLower() switch
        {
            "minecraft" => "bi-square-fill",
            "cs:go" or "counter-strike" => "bi-crosshair",
            "rust" => "bi-hammer",
            "ark" => "bi-egg",
            "terraria" => "bi-tree-fill",
            "valheim" => "bi-shield-fill",
            "7 days to die" => "bi-radioactive",
            _ => "bi-controller"
        };
    }

    private string FormatMemory(int ramMb)
    {
        if (ramMb >= 1024)
        {
            return $"{ramMb / 1024} GB";
        }
        return $"{ramMb} MB";
    }

    private int CalculateSavings(ServerTypeDto server)
    {
        if (server.HourlyPrice == 0) return 0;
        
        var hourlyMonthly = server.HourlyPrice * 730; // Average hours per month
        if (hourlyMonthly == 0) return 0;
        
        var savings = ((hourlyMonthly - server.MonthlyPrice) / hourlyMonthly) * 100;
        return (int)Math.Round(savings);
    }
}
