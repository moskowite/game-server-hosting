@page "/"

<PageTitle>Home - ServerHost Pro Gaming</PageTitle>

<div class="home-container">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <div class="hero-badge">
                <span class="badge-icon">⚡</span>
                <span class="badge-text">99.9% Uptime Guaranteed</span>
            </div>
            <h1 class="hero-title">
                Premium Game Server
                <span class="hero-gradient">Hosting</span>
            </h1>
            <p class="hero-description">
                Deploy high-performance game servers in seconds. Built for gamers, optimized for peak performance,
                backed by enterprise-grade infrastructure.
            </p>
            <div class="hero-actions">
                <a href="/servers" class="btn btn-primary btn-lg">
                    <span class="bi bi-rocket-takeoff"></span>
                    Get Started
                </a>
                <a href="/plans/compare" class="btn btn-outline-primary btn-lg">
                    <span class="bi bi-bar-chart"></span>
                    Compare Plans
                </a>
            </div>
            <div class="hero-stats">
                <div class="stat">
                    <div class="stat-value">10K+</div>
                    <div class="stat-label">Active Servers</div>
                </div>
                <div class="stat">
                    <div class="stat-value">50+</div>
                    <div class="stat-label">Game Types</div>
                </div>
                <div class="stat">
                    <div class="stat-value">24/7</div>
                    <div class="stat-label">Support</div>
                </div>
            </div>
        </div>
        <div class="hero-visual">
            <div class="floating-card card-1">
                <span class="bi bi-cpu"></span>
                <div>16 Core CPU</div>
            </div>
            <div class="floating-card card-2">
                <span class="bi bi-lightning-charge"></span>
                <div>NVMe Storage</div>
            </div>
            <div class="floating-card card-3">
                <span class="bi bi-shield-check"></span>
                <div>DDoS Protection</div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="section-header">
            <h2 class="section-title">Why Choose ServerHost?</h2>
            <p class="section-description">Everything you need to run the perfect game server</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="bi bi-lightning"></span>
                </div>
                <h3 class="feature-title">Instant Deployment</h3>
                <p class="feature-description">
                    Launch your game server in under 60 seconds. No complex setup, just pure gaming.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="bi bi-speedometer2"></span>
                </div>
                <h3 class="feature-title">Peak Performance</h3>
                <p class="feature-description">
                    Latest AMD Ryzen & Intel processors with DDR5 RAM for zero lag gameplay.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="bi bi-shield-fill-check"></span>
                </div>
                <h3 class="feature-title">DDoS Protection</h3>
                <p class="feature-description">
                    Enterprise-grade security keeps your server safe from attacks 24/7.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="bi bi-clock-history"></span>
                </div>
                <h3 class="feature-title">Automatic Backups</h3>
                <p class="feature-description">
                    Daily backups with one-click restore. Your world is always protected.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="bi bi-sliders"></span>
                </div>
                <h3 class="feature-title">Full Control</h3>
                <p class="feature-description">
                    Complete FTP, console, and mod support. Your server, your rules.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <span class="bi bi-headset"></span>
                </div>
                <h3 class="feature-title">24/7 Support</h3>
                <p class="feature-description">
                    Expert gaming support team available around the clock via chat and tickets.
                </p>
            </div>
        </div>
    </section>

    <!-- Popular Games Section -->
    <section class="games-section">
        <div class="section-header">
            <h2 class="section-title">Popular Game Servers</h2>
            <p class="section-description">Host any of your favorite games</p>
        </div>
        <div class="games-grid">
            <div class="game-card">
                <div class="game-icon minecraft">
                    <span class="bi bi-box-fill"></span>
                </div>
                <h4 class="game-name">Minecraft</h4>
            </div>
            <div class="game-card">
                <div class="game-icon rust">
                    <span class="bi bi-hammer"></span>
                </div>
                <h4 class="game-name">Rust</h4>
            </div>
            <div class="game-card">
                <div class="game-icon csgo">
                    <span class="bi bi-crosshair"></span>
                </div>
                <h4 class="game-name">CS:GO</h4>
            </div>
            <div class="game-card">
                <div class="game-icon ark">
                    <span class="bi bi-egg"></span>
                </div>
                <h4 class="game-name">ARK</h4>
            </div>
            <div class="game-card">
                <div class="game-icon valheim">
                    <span class="bi bi-shield"></span>
                </div>
                <h4 class="game-name">Valheim</h4>
            </div>
            <div class="game-card">
                <div class="game-icon terraria">
                    <span class="bi bi-tree"></span>
                </div>
                <h4 class="game-name">Terraria</h4>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="cta-content">
            <h2 class="cta-title">Ready to Start Your Gaming Journey?</h2>
            <p class="cta-description">
                Join thousands of gamers worldwide running their servers on ServerHost
            </p>
            <a href="/servers" class="btn btn-primary btn-lg">
                <span class="bi bi-rocket-takeoff"></span>
                Browse Servers
            </a>
        </div>
    </section>
</div>
