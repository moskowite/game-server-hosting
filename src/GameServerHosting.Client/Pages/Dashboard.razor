@page "/dashboard"
@inject DashboardService DashboardService
@inject ServerManagementService ServerManagementService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard - Game Server Hosting</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="dashboard-container">
    @if (isLoading)
    {
        <div class="loading-spinner">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading your dashboard...</p>
        </div>
    }
    else if (dashboardData == null)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error Loading Dashboard</h4>
            <p>Unable to load your dashboard data. Please try refreshing the page.</p>
            <button class="btn btn-primary" @onclick="LoadDashboardData">Retry</button>
        </div>
    }
    else
    {
        <!-- Header Section -->
        <div class="dashboard-header">
            <div class="welcome-section">
                <h1>Welcome back, @dashboardData.UserProfile.FirstName!</h1>
                <p class="text-muted">Here's what's happening with your game servers</p>
            </div>
            <div class="user-info-card">
                <div class="user-avatar">
                    @GetInitials(dashboardData.UserProfile.FirstName, dashboardData.UserProfile.LastName)
                </div>
                <div class="user-details">
                    <h5>@dashboardData.UserProfile.FirstName @dashboardData.UserProfile.LastName</h5>
                    <p class="text-muted">@dashboardData.UserProfile.Email</p>
                    <span class="badge bg-@(dashboardData.UserProfile.EmailConfirmed ? "success" : "warning")">
                        @(dashboardData.UserProfile.EmailConfirmed ? "Verified" : "Unverified")
                    </span>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon bg-primary">
                    <i class="bi bi-hdd-rack"></i>
                </div>
                <div class="stat-content">
                    <h3>@dashboardData.Stats.TotalServers</h3>
                    <p>Total Servers</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-success">
                    <i class="bi bi-play-circle"></i>
                </div>
                <div class="stat-content">
                    <h3>@dashboardData.Stats.RunningServers</h3>
                    <p>Running Servers</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-info">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="stat-content">
                    <h3>@dashboardData.Stats.TotalOrders</h3>
                    <p>Total Orders</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-warning">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div class="stat-content">
                    <h3>@dashboardData.Stats.TotalSpent.ToString("C")</h3>
                    <p>Total Spent</p>
                </div>
            </div>
        </div>

        <!-- Active Servers Section -->
        <div class="section-container">
            <div class="section-header">
                <h2><i class="bi bi-server"></i> Your Game Servers</h2>
                <button class="btn btn-primary btn-sm" @onclick="NavigateToServerCatalog">
                    <i class="bi bi-plus-circle"></i> New Server
                </button>
            </div>
            
            @if (dashboardData.ActiveServers.Any())
            {
                <div class="servers-grid">
                    @foreach (var server in dashboardData.ActiveServers)
                    {
                        var metrics = serverMetrics.GetValueOrDefault(server.Id);
                        var isLoadingAction = loadingActions.Contains(server.Id);
                        
                        <div class="server-card">
                            <!-- Server Header -->
                            <div class="server-card-header">
                                <div class="server-title-section">
                                    <div class="server-icon">
                                        <i class="bi @GetGameIcon(server.GameName)"></i>
                                    </div>
                                    <div>
                                        <h4 class="server-name">@server.ServerName</h4>
                                        <p class="server-type">@server.ServerTypeName</p>
                                    </div>
                                </div>
                                <div class="server-status-badge">
                                    <span class="status-indicator status-@GetStatusClass(server.Status)"></span>
                                    <span class="status-text">@server.Status</span>
                                </div>
                            </div>

                            <!-- Server Info -->
                            <div class="server-info">
                                <div class="info-item">
                                    <i class="bi bi-controller"></i>
                                    <span>@server.GameName</span>
                                </div>
                                @if (!string.IsNullOrEmpty(server.IpAddress))
                                {
                                    <div class="info-item">
                                        <i class="bi bi-hdd-network"></i>
                                        <code>@server.IpAddress:@server.Port</code>
                                    </div>
                                }
                                <div class="info-item">
                                    <i class="bi bi-people"></i>
                                    <span>Max @server.MaxPlayers Players</span>
                                </div>
                                @if (server.ExpiresAt.HasValue)
                                {
                                    var daysUntilExpiry = (server.ExpiresAt.Value - DateTime.UtcNow).Days;
                                    <div class="info-item">
                                        <i class="bi bi-calendar-event"></i>
                                        <span class="@(daysUntilExpiry < 7 ? "text-danger" : "")">
                                            Expires @server.ExpiresAt.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                }
                            </div>

                            <!-- Resource Usage -->
                            @if (metrics != null)
                            {
                                <div class="resource-usage">
                                    <h5 class="resource-title">Resource Usage</h5>
                                    
                                    <div class="resource-item">
                                        <div class="resource-label">
                                            <i class="bi bi-cpu"></i>
                                            <span>CPU</span>
                                        </div>
                                        <div class="resource-bar-container">
                                            <div class="resource-bar">
                                                <div class="resource-fill resource-fill-@GetUsageLevel(metrics.CpuUsagePercent)" 
                                                     style="width: @metrics.CpuUsagePercent%"></div>
                                            </div>
                                            <span class="resource-value">@metrics.CpuUsagePercent.ToString("F1")%</span>
                                        </div>
                                    </div>

                                    <div class="resource-item">
                                        <div class="resource-label">
                                            <i class="bi bi-memory"></i>
                                            <span>Memory</span>
                                        </div>
                                        <div class="resource-bar-container">
                                            <div class="resource-bar">
                                                <div class="resource-fill resource-fill-@GetUsageLevel(metrics.MemoryUsagePercent)" 
                                                     style="width: @metrics.MemoryUsagePercent%"></div>
                                            </div>
                                            <span class="resource-value">@metrics.MemoryUsagePercent.ToString("F1")%</span>
                                        </div>
                                    </div>

                                    <div class="resource-item">
                                        <div class="resource-label">
                                            <i class="bi bi-hdd"></i>
                                            <span>Disk</span>
                                        </div>
                                        <div class="resource-bar-container">
                                            <div class="resource-bar">
                                                <div class="resource-fill resource-fill-@GetUsageLevel(metrics.DiskUsagePercent)" 
                                                     style="width: @metrics.DiskUsagePercent%"></div>
                                            </div>
                                            <span class="resource-value">@metrics.DiskUsagePercent.ToString("F1")%</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (server.Status == ServerStatus.Running)
                            {
                                <div class="resource-loading">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">Loading metrics...</span>
                                    </div>
                                    <span>Loading resource usage...</span>
                                </div>
                            }

                            <!-- Quick Actions -->
                            <div class="server-actions">
                                @if (isLoadingAction)
                                {
                                    <div class="action-loading">
                                        <div class="spinner-border spinner-border-sm" role="status"></div>
                                        <span>Processing...</span>
                                    </div>
                                }
                                else
                                {
                                    @if (server.Status == ServerStatus.Running)
                                    {
                                        <button class="btn btn-action btn-warning" 
                                                @onclick="() => StopServer(server.Id)"
                                                title="Stop Server">
                                            <i class="bi bi-stop-circle"></i>
                                            <span>Stop</span>
                                        </button>
                                        <button class="btn btn-action btn-info" 
                                                @onclick="() => RestartServer(server.Id)"
                                                title="Restart Server">
                                            <i class="bi bi-arrow-clockwise"></i>
                                            <span>Restart</span>
                                        </button>
                                    }
                                    else if (server.Status == ServerStatus.Stopped || server.Status == ServerStatus.Suspended)
                                    {
                                        <button class="btn btn-action btn-success" 
                                                @onclick="() => StartServer(server.Id)"
                                                title="Start Server">
                                            <i class="bi bi-play-circle"></i>
                                            <span>Start</span>
                                        </button>
                                    }
                                    
                                    <button class="btn btn-action btn-primary" 
                                            @onclick="() => ManageServer(server.Id)"
                                            title="Manage Server">
                                        <i class="bi bi-gear"></i>
                                        <span>Manage</span>
                                    </button>
                                    
                                    @if (server.Status != ServerStatus.Pending)
                                    {
                                        <button class="btn btn-action btn-danger" 
                                                @onclick="() => DeleteServer(server.Id)"
                                                title="Delete Server">
                                            <i class="bi bi-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h3>No Active Servers</h3>
                    <p>You don't have any servers yet. Create your first server to get started!</p>
                    <button class="btn btn-primary" @onclick="NavigateToServerCatalog">
                        <i class="bi bi-plus-circle"></i> Browse Server Catalog
                    </button>
                </div>
            }
        </div>

        <!-- Order History Section -->
        <div class="section-container">
            <div class="section-header">
                <h2><i class="bi bi-clock-history"></i> Recent Orders</h2>
                <a href="/orders" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
            
            @if (dashboardData.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order Number</th>
                                <th>Type</th>
                                <th>Server/Plan</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment Method</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in dashboardData.RecentOrders)
                            {
                                <tr>
                                    <td><code>@order.OrderNumber</code></td>
                                    <td>
                                        <span class="badge bg-secondary">@order.OrderType</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.ServerName))
                                        {
                                            <div>
                                                <strong>@order.ServerName</strong>
                                                <br />
                                                <small class="text-muted">@order.GameName</small>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(order.PlanName))
                                        {
                                            <span>@order.PlanName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td><strong>@order.TotalAmount.ToString("C")</strong></td>
                                    <td>
                                        <span class="badge bg-@GetOrderStatusColor(order.Status)">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small>@order.PaymentMethod</small>
                                    </td>
                                    <td>
                                        <small>@order.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-receipt"></i>
                    <h3>No Orders Yet</h3>
                    <p>Your order history will appear here once you make your first purchase.</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private DashboardDto? dashboardData;
    private Dictionary<Guid, ServerMetrics> serverMetrics = new();
    private HashSet<Guid> loadingActions = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        dashboardData = await DashboardService.GetDashboardDataAsync();
        isLoading = false;

        // Load metrics for running servers
        if (dashboardData?.ActiveServers != null)
        {
            foreach (var server in dashboardData.ActiveServers.Where(s => s.Status == ServerStatus.Running))
            {
                _ = LoadServerMetrics(server.Id);
            }
        }
    }

    private async Task LoadServerMetrics(Guid serverId)
    {
        var metrics = await ServerManagementService.GetServerMetricsAsync(serverId);
        if (metrics != null)
        {
            serverMetrics[serverId] = metrics;
            StateHasChanged();
        }
    }

    private string GetInitials(string firstName, string lastName)
    {
        var initials = "";
        if (!string.IsNullOrEmpty(firstName))
            initials += firstName[0];
        if (!string.IsNullOrEmpty(lastName))
            initials += lastName[0];
        return initials.ToUpper();
    }

    private string GetStatusClass(ServerStatus status)
    {
        return status switch
        {
            ServerStatus.Running => "running",
            ServerStatus.Stopped => "stopped",
            ServerStatus.Pending => "pending",
            ServerStatus.Suspended => "suspended",
            ServerStatus.Terminated => "terminated",
            _ => "unknown"
        };
    }

    private string GetStatusColor(ServerStatus status)
    {
        return status switch
        {
            ServerStatus.Running => "success",
            ServerStatus.Stopped => "warning",
            ServerStatus.Pending => "info",
            ServerStatus.Suspended => "danger",
            ServerStatus.Terminated => "secondary",
            _ => "secondary"
        };
    }

    private string GetOrderStatusColor(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Completed => "success",
            OrderStatus.Pending => "warning",
            OrderStatus.Failed => "danger",
            OrderStatus.Refunded => "info",
            _ => "secondary"
        };
    }

    private string GetGameIcon(string gameName)
    {
        return gameName.ToLower() switch
        {
            var name when name.Contains("minecraft") => "bi-box",
            var name when name.Contains("counter-strike") || name.Contains("cs:go") => "bi-bullseye",
            var name when name.Contains("rust") => "bi-hammer",
            var name when name.Contains("ark") => "bi-egg",
            var name when name.Contains("valheim") => "bi-tree",
            var name when name.Contains("terraria") => "bi-dirt",
            _ => "bi-controller"
        };
    }

    private string GetUsageLevel(double percentage)
    {
        if (percentage < 50)
            return "low";
        else if (percentage < 80)
            return "medium";
        else
            return "high";
    }

    private void NavigateToServerCatalog()
    {
        NavigationManager.NavigateTo("/servers");
    }

    private void ManageServer(Guid serverId)
    {
        // Navigate to server management page (to be implemented)
        NavigationManager.NavigateTo($"/servers/manage/{serverId}");
    }

    private async Task StartServer(Guid serverId)
    {
        loadingActions.Add(serverId);
        StateHasChanged();

        var success = await ServerManagementService.StartServerAsync(serverId);
        
        loadingActions.Remove(serverId);
        
        if (success)
        {
            await LoadDashboardData();
        }
        else
        {
            // Show error message (you might want to add a toast notification system)
            Console.WriteLine("Failed to start server");
        }
    }

    private async Task StopServer(Guid serverId)
    {
        loadingActions.Add(serverId);
        StateHasChanged();

        var success = await ServerManagementService.StopServerAsync(serverId);
        
        loadingActions.Remove(serverId);
        
        if (success)
        {
            await LoadDashboardData();
        }
        else
        {
            Console.WriteLine("Failed to stop server");
        }
    }

    private async Task RestartServer(Guid serverId)
    {
        loadingActions.Add(serverId);
        StateHasChanged();

        var success = await ServerManagementService.RestartServerAsync(serverId);
        
        loadingActions.Remove(serverId);
        
        if (success)
        {
            await LoadDashboardData();
        }
        else
        {
            Console.WriteLine("Failed to restart server");
        }
    }

    private async Task DeleteServer(Guid serverId)
    {
        // Add confirmation dialog in production
        if (!await ConfirmDelete())
            return;

        loadingActions.Add(serverId);
        StateHasChanged();

        var success = await ServerManagementService.DeleteServerAsync(serverId);
        
        loadingActions.Remove(serverId);
        
        if (success)
        {
            await LoadDashboardData();
        }
        else
        {
            Console.WriteLine("Failed to delete server");
        }
    }

    private async Task<bool> ConfirmDelete()
    {
        // Simple confirmation for now - in production, use a modal dialog
        return true;
    }
}
    </Authorized>
</AuthorizeView>
