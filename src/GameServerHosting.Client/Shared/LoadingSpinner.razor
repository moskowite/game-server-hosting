@* Reusable loading spinner with customizable message *@

<div class="loading-spinner-container @SizeClass">
    <div class="spinner-wrapper">
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
    </div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="loading-message">@Message</p>
    }
</div>

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public LoadingSize Size { get; set; } = LoadingSize.Medium;

    private string SizeClass => Size switch
    {
        LoadingSize.Small => "size-small",
        LoadingSize.Medium => "size-medium",
        LoadingSize.Large => "size-large",
        _ => "size-medium"
    };

    public enum LoadingSize
    {
        Small,
        Medium,
        Large
    }
}

