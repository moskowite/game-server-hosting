@inject CartService CartService
@implements IDisposable

<div class="nav-container">
    <!-- Brand Header -->
    <div class="nav-brand">
        <a href="/" class="brand-link">
            <div class="brand-icon">
                <span class="bi bi-stars"></span>
            </div>
            <div class="brand-text">
                <h1 class="brand-title">ServerHost</h1>
                <p class="brand-subtitle">Pro Gaming</p>
            </div>
        </a>
    </div>

    <!-- Navigation Menu -->
    <nav class="nav-menu">
        <div class="nav-section">
            <span class="nav-section-title">Main</span>
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon bi bi-house-door"></span>
                <span class="nav-text">Home</span>
            </NavLink>
            <NavLink class="nav-link" href="dashboard">
                <span class="nav-icon bi bi-speedometer2"></span>
                <span class="nav-text">Dashboard</span>
            </NavLink>
            <NavLink class="nav-link" href="servers">
                <span class="nav-icon bi bi-hdd-rack"></span>
                <span class="nav-text">Server Catalog</span>
            </NavLink>
        </div>

        <div class="nav-section">
            <span class="nav-section-title">Management</span>
            <NavLink class="nav-link" href="plans/compare">
                <span class="nav-icon bi bi-layers"></span>
                <span class="nav-text">Compare Plans</span>
            </NavLink>
            <NavLink class="nav-link nav-link-cart" href="cart">
                <span class="nav-icon bi bi-cart3"></span>
                <span class="nav-text">Shopping Cart</span>
                @if (CartService.ItemCount > 0)
                {
                    <span class="cart-badge">@CartService.ItemCount</span>
                }
            </NavLink>
        </div>

        <div class="nav-section">
            <span class="nav-section-title">Account</span>
            <NavLink class="nav-link" href="settings">
                <span class="nav-icon bi bi-gear"></span>
                <span class="nav-text">Settings</span>
            </NavLink>
        </div>
    </nav>

    <!-- Bottom Section -->
    <div class="nav-footer">
        <div class="status-card">
            <div class="status-indicator">
                <span class="status-dot"></span>
                <span class="status-text">All Systems Operational</span>
            </div>
            <a href="https://status.example.com" class="status-link" target="_blank">
                <span class="bi bi-arrow-up-right"></span>
            </a>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await CartService.InitializeAsync();
        CartService.OnCartUpdated += OnCartUpdated;
    }

    private void OnCartUpdated(CartNotification notification)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        CartService.OnCartUpdated -= OnCartUpdated;
    }
}
