@using GameServerHosting.Client.Services
@inherits LayoutComponentBase
@inject AppStateService AppState

<div class="app-layout">
    <!-- Sidebar Navigation -->
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="app-main">
        <!-- Top Bar -->
        <header class="app-topbar">
            <div class="topbar-content">
                <div class="topbar-left">
                    <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu" aria-label="Toggle menu">
                        <span class="bi bi-list"></span>
                    </button>
                    <h2 class="page-title">@GetPageTitle()</h2>
                </div>
                <div class="topbar-right">
                    <button class="topbar-action" title="Notifications">
                        <span class="bi bi-bell"></span>
                        <span class="notification-badge">3</span>
                    </button>
                    <UserProfileMenu />
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="app-content">
            <article class="content-wrapper">
                @Body
            </article>
        </main>
    </div>
</div>

<!-- Mobile Menu Overlay -->
@if (AppState.IsMobileMenuOpen)
{
    <div class="mobile-menu-overlay" @onclick="() => AppState.ToggleMobileMenu()"></div>
}

<!-- Global Components -->
<CartNotificationToast />
<CartSidebar />
<ToastNotification />
<LoadingOverlay />
<DevPanel />

@code {
    private void ToggleMobileMenu()
    {
        AppState.ToggleMobileMenu();
    }

    private string GetPageTitle()
    {
        // Get page title from AppState (can be set by individual pages)
        return AppState.PageTitle;
    }
}
