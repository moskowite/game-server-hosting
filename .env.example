# Environment Variables for Docker Compose
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gameserverhosting_dev

# =============================================================================
# API Configuration
# =============================================================================
# JWT Secret Key - MUST be at least 32 characters for production
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_PRODUCTION

# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# Stripe Payment Configuration (Optional)
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get this from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# DigitalOcean Configuration (Optional)
# =============================================================================
# Required for server provisioning features
# Get this from https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=dop_v1_...

# =============================================================================
# Email Configuration (Development)
# =============================================================================
# MailDev is used by default for development (no configuration needed)
# SMTP Web UI: http://localhost:1080
# SMTP Server: localhost:1025

# =============================================================================
# Notes
# =============================================================================
# 1. Never commit the .env file to version control
# 2. For production, use strong passwords and secure key management
# 3. Optional variables can be left empty for development
# 4. The API will use MailDev for emails in development mode
